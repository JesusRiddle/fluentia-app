    {
      "id": "pa194",
      "es": "¿Qué haces en tu tiempo libre? / ¿Qué hace en su tiempo libre?",
      "translations": {
        "en": "What do you do in your free time?",
        "pt": "O que você faz no seu tempo livre? / O que o senhor faz no tempo livre? / O que a senhora faz no tempo livre?",
        "fr": "Qu'est-ce que tu fais pendant ton temps libre ? / Qu'est-ce que vous faites pendant votre temps libre ?",
        "it": "Che cosa fai nel tempo libero? / Che cosa fa nel tempo libero?",
        "de": "Was machst du in deiner Freizeit? / Was machen Sie in Ihrer Freizeit?"
      },
      "image_url": "",
      "notes": {
        "pt": "«Você» es de uso cotidiano en Brasil; «o senhor» y «a senhora» son formas de trato respetuoso."
      }
    },
    {
      "id": "pa195",
      "es": "¿Tienes algún pasatiempo? / ¿Tiene algún pasatiempo?",
      "translations": {
        "en": "Do you have any hobbies?",
        "pt": "Você tem algum hobby? / O senhor tem algum hobby? / A senhora tem algum hobby?",
        "fr": "Tu as des loisirs ? / Vous avez des loisirs ?",
        "it": "Hai qualche hobby? / Ha qualche hobby?",
        "de": "Hast du ein Hobby? / Haben Sie ein Hobby?"
      },
      "image_url": "",
      "notes": {
        "pt": "«Você» es de uso cotidiano en Brasil; «o senhor» y «a senhora» son formas de trato respetuoso."
      }
    },
    {
      "id": "pa196",
      "es": "Mi pasatiempo favorito es la fotografía.",
