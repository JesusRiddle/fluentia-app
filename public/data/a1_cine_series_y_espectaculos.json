{
  "module": "Cine, series y espectáculos",
  "level": "A1",
  "cards": [
    {
      "id": "pa88",
      "es": "Ver televisión / Mirar la televisión",
      "translations": {
        "en": "To watch TV",
        "pt": "Assistir à televisão / Ver televisão",
        "fr": "Regarder la télévision",
        "it": "Guardare la televisione",
        "de": "Fernsehen"
      },
      "image_url": "",
      "notes": {
        "es": "Coloquial: Ver la tele",
        "pt": "«Assistir à televisão» es la forma con preposición del registro cuidado; «ver televisão» también es de uso corriente.",
        "de": "Como verbo se escribe «fernsehen» y es separable."
      }
    },
    {
      "id": "pa89",
      "es": "Navegar por internet",
      "translations": {
        "en": "To browse the internet / To surf the internet",
        "pt": "Navegar na internet",
        "fr": "Naviguer sur Internet / Surfer sur Internet",
        "it": "Navigare su Internet",
        "de": "Im Internet surfen"
      },
      "image_url": ""
    },
    {
      "id": "pa90",
      "es": "Escuchar un podcast",
      "translations": {
        "en": "To listen to a podcast",
        "pt": "Ouvir um podcast",
        "fr": "Écouter un podcast",
        "it": "Ascoltare un podcast",
        "de": "Einen Podcast hören"
      },
      "image_url": ""
    },
    {
      "id": "pa113",
      "es": "La película",
      "translations": {
        "en": "The movie",
        "pt": "O filme",
        "fr": "Le film",
        "it": "Il film",
        "de": "Der Film"
      },
      "image_url": "",
      "notes": {
        "en": "(Plural: The movies) «Film» también se usa en Estados Unidos; «movie» es habitual en la conversación.",
        "pt": "(Plural: Os filmes)",
        "fr": "(Plural: Les films)",
        "it": "(Plural: I film)",
        "de": "(Plural: Die Filme)"
      }
    },
    {
      "id": "pa114",
      "es": "La serie de televisión",
      "translations": {
        "en": "The television series",
        "pt": "A série de televisão",
        "fr": "La série télévisée",
        "it": "La serie televisiva",
        "de": "Die Fernsehserie"
      },
      "image_url": "",
      "notes": {
        "en": "(Plural: The television series) Abreviatura: TV, como en «TV series»",
        "pt": "(Plural: As séries de televisão) Abreviatura: TV, como en «série de TV»",
        "fr": "(Plural: Les séries télévisées)",
        "it": "(Plural: Le serie televisive) Abreviatura: TV, como en «serie TV»",
        "de": "(Plural: Die Fernsehserien) Abreviatura: TV, como en «TV-Serie»"
      }
    },
    {
      "id": "pa115",
      "es": "El episodio / El capítulo",
      "translations": {
        "en": "The episode",
        "pt": "O episódio",
        "fr": "L'épisode",
        "it": "L'episodio / La puntata",
        "de": "Die Folge"
      },
      "image_url": "",
      "notes": {
        "en": "(Plural: The episodes)",
        "pt": "(Plural: Os episódios)",
        "fr": "(Plural: Les épisodes)",
        "it": "(Plural: Gli episodi / Le puntate) «Episodio» y «puntata» pueden nombrar una entrega de una serie.",
        "es": "(De una serie, no de un libro)",
        "de": "(Plural: Die Folgen) En series también se usa «die Episode»."
      }
    },
    {
      "id": "pa116",
      "es": "La temporada",
      "translations": {
        "en": "The season",
        "pt": "A temporada",
        "fr": "La saison",
        "it": "La stagione",
        "de": "Die Staffel"
      },
      "image_url": "",
      "notes": {
        "en": "(Plural: The seasons)",
        "pt": "(Plural: As temporadas)",
        "fr": "(Plural: Les saisons)",
        "it": "(Plural: Le stagioni)",
        "es": "(Conjunto de episodios de una serie)",
        "de": "(Plural: Die Staffeln) Aquí es la temporada de una serie, no una estación del año."
      }
    },
    {
      "id": "pa117",
      "es": "El documental",
      "translations": {
        "en": "The documentary",
        "pt": "O documentário",
        "fr": "Le documentaire",
        "it": "Il documentario",
        "de": "Der Dokumentarfilm"
      },
      "image_url": "",
      "notes": {
        "en": "(Plural: The documentaries)",
        "pt": "(Plural: Os documentários)",
        "fr": "(Plural: Les documentaires)",
        "it": "(Plural: I documentari)",
        "de": "(Plural: Die Dokumentarfilme) Coloquial: Die Doku"
      }
    },
    {
      "id": "pa118",
      "es": "Las caricaturas / Los dibujos animados",
      "translations": {
        "en": "The animated cartoons",
        "pt": "Os desenhos animados",
        "fr": "Les dessins animés",
        "it": "I cartoni animati",
        "de": "Die Zeichentrickfilme"
      },
      "image_url": "",
      "notes": {
        "es": "(Animación, no caricaturas impresas)",
        "en": "«Cartoons» a secas también puede referirse a dibujos impresos.",
        "fr": "Singular: Le dessin animé",
        "it": "Singular: Il cartone animato",
        "pt": "Singular: O desenho animado",
        "de": "Singular: Der Zeichentrickfilm"
      }
    },
    {
      "id": "pa119",
      "es": "La comedia",
      "translations": {
        "en": "The comedy",
        "pt": "A comédia",
        "fr": "La comédie",
        "it": "La commedia",
        "de": "Die Komödie"
      },
      "image_url": "",
      "notes": {
        "es": "(Género de cine o televisión)",
        "en": "También se usa sin artículo al hablar del género en general.",
        "de": "(Plural: Die Komödien) El plural se refiere a obras concretas."
      }
    },
    {
      "id": "pa120",
      "es": "La película dramática",
      "translations": {
        "en": "The drama",
        "pt": "O filme de drama",
        "fr": "Le film dramatique",
        "it": "Il film drammatico",
        "de": "Das Filmdrama"
      },
      "image_url": "",
      "notes": {
        "en": "(Plural: The dramas) (Película del género dramático)",
        "pt": "(Plural: Os filmes de drama)",
        "fr": "(Plural: Les films dramatiques)",
        "it": "(Plural: I film drammatici)",
        "de": "(Plural: Die Filmdramen) «Drama» también puede referirse a una obra teatral o a un conflicto."
      }
    },
    {
      "id": "pa121",
      "es": "La película de acción",
      "translations": {
        "en": "The action movie",
        "pt": "O filme de ação",
        "fr": "Le film d'action",
        "it": "Il film d'azione",
        "de": "Der Actionfilm"
      },
      "image_url": "",
      "notes": {
        "en": "(Plural: The action movies)",
        "pt": "(Plural: Os filmes de ação)",
        "fr": "(Plural: Les films d'action)",
        "it": "(Plural: I film d'azione)",
        "de": "(Plural: Die Actionfilme)"
      }
    },
    {
      "id": "pa122",
      "es": "La película de terror",
      "translations": {
        "en": "The horror movie",
        "pt": "O filme de terror",
        "fr": "Le film d'horreur",
        "it": "Il film dell'orrore",
        "de": "Der Horrorfilm"
      },
      "image_url": "",
      "notes": {
        "en": "(Plural: The horror movies)",
        "pt": "(Plural: Os filmes de terror)",
        "fr": "(Plural: Les films d'horreur)",
        "it": "(Plural: I film dell'orrore)",
        "de": "(Plural: Die Horrorfilme)"
      }
    },
