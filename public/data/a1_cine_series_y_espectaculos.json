      "id": "pa123",
      "es": "La película de aventuras",
      "translations": {
        "en": "The adventure movie",
        "pt": "O filme de aventura",
        "fr": "Le film d'aventure",
        "it": "Il film d'avventura",
        "de": "Der Abenteuerfilm"
      },
      "image_url": "",
      "notes": {
        "en": "(Plural: The adventure movies)",
        "pt": "(Plural: Os filmes de aventura)",
        "fr": "(Plural: Les films d'aventure)",
        "it": "(Plural: I film d'avventura)",
        "de": "(Plural: Die Abenteuerfilme)"
      }
    },
    {
      "id": "pa124",
      "es": "La ciencia ficción",
      "translations": {
        "en": "Science fiction",
        "pt": "A ficção científica",
        "fr": "La science-fiction",
        "it": "La fantascienza",
        "de": "Die Science-Fiction"
      },
      "image_url": "",
      "notes": {
        "es": "(Género de cine o televisión)",
        "en": "Abreviatura: Sci-fi (de uso informal)",
        "de": "Abreviatura: Sci-Fi"
      }
    },
    {
      "id": "pa125",
      "es": "La película romántica",
      "translations": {
        "en": "The romantic movie",
        "pt": "O filme de romance",
        "fr": "Le film romantique",
        "it": "Il film romantico",
        "de": "Der Liebesfilm"
      },
      "image_url": "",
      "notes": {
        "en": "(Plural: The romantic movies)",
        "pt": "(Plural: Os filmes de romance)",
        "fr": "(Plural: Les films romantiques)",
        "it": "(Plural: I film romantici)",
        "de": "(Plural: Die Liebesfilme)"
      }
    },
    {
      "id": "pa126",
      "es": "La obra de teatro",
      "translations": {
        "en": "The play",
        "pt": "A peça de teatro",
        "fr": "La pièce de théâtre",
        "it": "L'opera teatrale",
        "de": "Das Theaterstück"
      },
      "image_url": "",
      "notes": {
        "en": "(Plural: The plays)",
        "pt": "(Plural: As peças de teatro)",
        "fr": "(Plural: Les pièces de théâtre)",
        "it": "(Plural: Le opere teatrali) «Spettacolo teatrale» puede referirse a otros espectáculos que no son obras de teatro.",
        "de": "(Plural: Die Theaterstücke)"
      }
    },
    {
      "id": "pa127",
      "es": "El musical / La comedia musical",
      "translations": {
        "en": "The stage musical",
        "pt": "O musical",
        "fr": "La comédie musicale",
        "it": "Il musical",
        "de": "Das Musical"
      },
      "image_url": "",
      "notes": {
        "en": "(Plural: The stage musicals)",
        "pt": "(Plural: Os musicais)",
        "fr": "(Plural: Les comédies musicales)",
        "it": "(Plural: I musical)",
        "es": "(Obra de teatro con canciones, no un concierto)",
        "de": "(Plural: Die Musicals)"
      }
    },
    {
      "id": "pa128",
      "es": "El espectáculo / El show",
      "translations": {
        "en": "The show",
        "pt": "O espetáculo",
        "fr": "Le spectacle",
        "it": "Lo spettacolo",
        "de": "Die Show"
      },
      "image_url": "",
      "notes": {
        "en": "(Plural: The shows)",
        "pt": "(Plural: Os espetáculos) «Show» es frecuente para espectáculos en vivo, en especial de música.",
        "fr": "(Plural: Les spectacles)",
        "it": "(Plural: Gli spettacoli)",
        "es": "«Show» es de uso común en conversaciones informales.",
        "de": "(Plural: Die Shows) Para un espectáculo en vivo también se usa «die Aufführung», según el contexto."
      }
    },
    {
      "id": "pa129",
      "es": "La exposición de arte",
      "translations": {
        "en": "The art exhibition",
        "pt": "A exposição de arte",
        "fr": "L'exposition d'art",
        "it": "La mostra d'arte",
        "de": "Die Kunstausstellung"
      },
      "image_url": "",
      "notes": {
        "en": "(Plural: The art exhibitions)",
        "pt": "(Plural: As exposições de arte)",
        "fr": "(Plural: Les expositions d'art)",
        "it": "(Plural: Le mostre d'arte)",
        "de": "(Plural: Die Kunstausstellungen)"
      }
    },
    {
      "id": "pa203",
      "es": "Prefiero las películas a las series.",
      "translations": {
        "en": "I prefer movies to TV series.",
        "pt": "Prefiro filmes a séries.",
        "fr": "Je préfère les films aux séries.",
        "it": "Preferisco i film alle serie TV.",
        "de": "Ich mag Filme lieber als Serien."
      },
      "image_url": ""
    },
    {
      "id": "pa208",
      "es": "¿Qué película me recomiendas? / ¿Qué película me recomienda usted?",
      "translations": {
        "en": "What movie do you recommend?",
        "pt": "Que filme você me recomenda?",
        "fr": "Quel film me conseilles-tu ? / Quel film me conseillez-vous ?",
        "it": "Che film mi consigli? / Che film mi consiglia?",
        "de": "Welchen Film empfiehlst du mir? / Welchen Film empfehlen Sie mir?"
      },
      "image_url": "",
      "notes": {
        "pt": "«Você» es de uso cotidiano. (Formal: Que filme o senhor me recomenda? / Que filme a senhora me recomenda?)"
      }
    },
    {
      "id": "pa209",
      "es": "¿Qué serie estás viendo? / ¿Qué serie está viendo usted?",
      "translations": {
        "en": "What series are you watching?",
        "pt": "Que série você está vendo?",
        "fr": "Quelle série regardes-tu ? / Quelle série regardez-vous ?",
        "it": "Che serie stai guardando? / Che serie sta guardando?",
        "de": "Welche Serie schaust du gerade? / Welche Serie schauen Sie gerade?"
      },
      "image_url": "",
      "notes": {
        "pt": "«Você» es de uso cotidiano. (Formal: Que série o senhor está vendo? / Que série a senhora está vendo?)"
      }
    },
    {
      "id": "pa210",
      "es": "Esta película tiene subtítulos.",
      "translations": {
        "en": "This movie has subtitles.",
        "pt": "Este filme tem legendas.",
        "fr": "Ce film est sous-titré.",
        "it": "Questo film è sottotitolato.",
        "de": "Dieser Film hat Untertitel."
      },
      "image_url": ""
    },
    {
      "id": "pa211",
      "es": "Veo las películas en su idioma original.",
      "translations": {
        "en": "I watch movies in their original language.",
        "pt": "Assisto a filmes no idioma original.",
        "fr": "Je regarde les films en version originale.",
        "it": "Guardo i film in lingua originale.",
        "de": "Ich schaue Filme in der Originalsprache."
      },
      "image_url": ""
    },
    {
      "id": "pa212",
      "es": "No me cuentes el final. / No me cuente el final.",
      "translations": {
        "en": "Don't tell me the ending.",
        "pt": "Não me conte o final.",
        "fr": "Ne me raconte pas la fin. / Ne me racontez pas la fin.",
        "it": "Non raccontarmi il finale. / Non mi racconti il finale.",
        "de": "Verrat mir nicht, wie es ausgeht. / Verraten Sie mir nicht, wie es ausgeht."
      },
      "image_url": "",
      "notes": {
        "pt": "«Não me conte o final» funciona con el tratamiento cotidiano «você» y también como petición cortés."
      }
    },
    {
      "id": "pa236",
      "es": "¿Quieres ir al cine conmigo? / ¿Quiere usted ir al cine conmigo?",
      "translations": {
        "en": "Would you like to go to the movies with me?",
        "pt": "Quer ir ao cinema comigo?",
        "fr": "Tu veux aller au cinéma avec moi ? / Voulez-vous aller au cinéma avec moi ?",
        "it": "Vuoi andare al cinema con me? / Vuole andare al cinema con me?",
        "de": "Möchtest du mit mir ins Kino gehen? / Möchten Sie mit mir ins Kino gehen?"
      },
      "image_url": "",
      "notes": {
        "pt": "«Quer ir ao cinema comigo?» es una invitación habitual. (Formal: O senhor quer ir ao cinema comigo? / A senhora quer ir ao cinema comigo?)"
      }
    },
    {
      "id": "pa253",
      "es": "¿A qué hora empieza el espectáculo?",
      "translations": {
        "en": "What time does the show start?",
        "pt": "A que horas começa o espetáculo?",
        "fr": "À quelle heure commence le spectacle ?",
        "it": "A che ora inizia lo spettacolo?",
        "de": "Um wie viel Uhr beginnt die Show?"
      },
      "image_url": ""
    }
  ]
}
