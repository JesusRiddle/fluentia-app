{
  "module": "Saludos y despedidas",
  "level": "A1",
  "cards": [
    {
      "id": "sd_001",
      "es": "Saludos y despedidas",
      "translations": {
        "en": "Greetings and goodbyes",
        "fr": "Salutations et formules d'au revoir",
        "it": "Saluti e formule di congedo",
        "pt": "Cumprimentos e despedidas"
      },
      "image_url": ""
    },
    {
      "id": "sd_002",
      "es": "Saludar",
      "translations": {
        "en": "To greet",
        "fr": "Saluer",
        "it": "Salutare",
        "pt": "Cumprimentar"
      },
      "image_url": ""
    },
    {
      "id": "sd_003",
      "es": "Despedirse",
      "translations": {
        "en": "To say goodbye",
        "fr": "Dire au revoir",
        "it": "Congedarsi / Salutarsi",
        "pt": "Despedir-se"
      },
      "image_url": "",
      "notes": {
        "it": "Salutarsi también puede referirse a saludarse al encontrarse; congedarsi especifica la despedida."
      }
    },
    {
      "id": "sd_004",
      "es": "Hola",
      "translations": {
        "en": "Hello",
        "fr": "Bonjour",
        "it": "Salve",
        "pt": "Olá"
      },
      "image_url": "",
      "notes": {
        "es": "(Saludo neutro o cortés)",
        "it": "Salve tiene un registro intermedio; en situaciones muy formales se prefiere buongiorno o buonasera.",
        "fr": "Bonjour se usa también para saludar durante el día."
      }
    },
    {
      "id": "sd_005",
      "es": "Hola",
      "translations": {
        "en": "Hi / Hi there",
        "fr": "Salut",
        "it": "Ciao",
        "pt": "Oi"
      },
      "image_url": "",
      "notes": {
        "es": "(Informal)",
        "fr": "(Informal) Salut también sirve para despedirse.",
        "it": "(Informal) Ciao también sirve para despedirse.",
        "pt": "Oi es muy habitual en Brasil, incluso en situaciones cotidianas con desconocidos."
      }
    },
    {
      "id": "sd_006",
      "es": "Hola a todos",
      "translations": {
        "en": "Hello everyone",
        "fr": "Bonjour à tous",
        "it": "Ciao a tutti",
        "pt": "Olá a todos"
      },
      "image_url": "",
      "notes": {
        "fr": "Para un grupo exclusivamente femenino: bonjour à toutes.",
        "it": "Para un grupo exclusivamente femenino: ciao a tutte.",
        "pt": "Para un grupo exclusivamente femenino: olá a todas."
      }
    },
    {
      "id": "sd_007",
      "es": "Hola de nuevo",
      "translations": {
        "en": "Hello again",
        "fr": "Rebonjour",
        "it": "Ciao di nuovo",
        "pt": "Olá de novo"
      },
      "image_url": ""
    },
    {
      "id": "sd_008",
      "es": "Buenos días",
      "translations": {
        "en": "Good morning",
        "fr": "Bonjour",
        "it": "Buongiorno",
        "pt": "Bom dia"
      },
      "image_url": "",
      "notes": {
        "fr": "Bonjour sirve tanto por la mañana como por la tarde, hasta que se empieza a usar bonsoir."
      }
    },
    {
      "id": "sd_009",
      "es": "Buenas tardes",
      "translations": {
        "en": "Good afternoon",
        "fr": "Bonjour",
        "it": "Buon pomeriggio / Buonasera",
        "pt": "Boa tarde"
      },
      "image_url": "",
      "notes": {
        "fr": "Bonjour se usa durante el día; bonsoir al final de la tarde o por la noche.",
        "it": "Buon pomeriggio es correcto, pero menos habitual como saludo. Buonasera puede empezar a usarse después de comer, según la región."
      }
    },
    {
      "id": "sd_010",
      "es": "Buenas noches",
      "translations": {
        "en": "Good evening",
        "fr": "Bonsoir",
        "it": "Buonasera",
        "pt": "Boa noite"
      },
      "image_url": "",
      "notes": {
        "es": "(Saludo al llegar por la noche)",
        "pt": "Boa noite se usa al llegar o despedirse por la noche."
      }
    },
    {
      "id": "sd_011",
      "es": "Buenas noches",
      "translations": {
        "en": "Good night",
        "fr": "Bonne nuit",
        "it": "Buonanotte",
        "pt": "Boa noite"
      },
      "image_url": "",
      "notes": {
        "es": "(Despedida antes de dormir)",
        "en": "Good night es una despedida, no un saludo al llegar.",
        "fr": "Bonne nuit se desea antes de dormir; al llegar por la noche se usa bonsoir.",
        "pt": "La misma fórmula sirve como saludo nocturno."
      }
    },
    {
      "id": "sd_012",
      "es": "Señor",
      "translations": {
        "en": "Sir",
        "fr": "Monsieur",
        "it": "Signore",
        "pt": "Senhor"
      },
      "image_url": "",
      "notes": {
        "es": "(Tratamiento al dirigirse a un hombre)",
        "en": "Sir se emplea al dirigirse cortésmente a un hombre; mister va normalmente con un apellido."
      }
    },
    {
      "id": "sd_013",
      "es": "Señora",
      "translations": {
        "en": "Ma'am",
        "fr": "Madame",
        "it": "Signora",
        "pt": "Senhora"
      },
      "image_url": "",
      "notes": {
        "es": "(Tratamiento al dirigirse a una mujer)",
        "en": "Ma'am es un tratamiento cortés; Mrs. se usa normalmente con un apellido."
      }
    },
    {
      "id": "sd_040",
      "es": "Bienvenido / Bienvenida / Bienvenidos / Bienvenidas",
      "translations": {
        "en": "Welcome",
        "fr": "Bienvenue",
        "it": "Benvenuto / Benvenuta / Benvenuti / Benvenute",
        "pt": "Bem-vindo / Bem-vinda / Bem-vindos / Bem-vindas"
      },
      "image_url": ""
    },
    {
      "id": "sd_042",
      "es": "Bienvenido de nuevo / Bienvenida de nuevo",
      "translations": {
        "en": "Welcome back",
        "fr": "Bon retour parmi nous",
        "it": "Bentornato / Bentornata",
        "pt": "Bem-vindo de volta / Bem-vinda de volta"
      },
      "image_url": ""
    },
    {
      "id": "sd_014",
      "es": "¿Cómo estás? / ¿Cómo está usted?",
      "translations": {
        "en": "How are you?",
        "fr": "Comment vas-tu ? / Comment allez-vous ?",
        "it": "Come stai? / Come sta?",
        "pt": "Como você está? / Como o senhor está? / Como a senhora está?"
      },
      "image_url": "",
      "notes": {
        "fr": "Primera forma informal; segunda formal o plural.",
        "it": "Primera forma informal; segunda formal.",
        "pt": "Você es habitual en Brasil; o senhor y a senhora expresan respeto."
      }
    },
    {
      "id": "sd_015",
      "es": "¿Qué tal?",
      "translations": {
        "en": "How's it going? / How are you doing?",
        "fr": "Comment ça va ? / Ça va ?",
        "it": "Come va?",
        "pt": "Como vai?"
      },
      "image_url": "",
      "notes": {
        "es": "(Saludo cotidiano)"
      }
    },
    {
      "id": "sd_016",
      "es": "¿Cómo están?",
      "translations": {
        "en": "How are you all?",
        "fr": "Comment allez-vous ?",
        "it": "Come state?",
        "pt": "Como vocês estão?"
      },
      "image_url": ""
    },
    {
      "id": "sd_017",
      "es": "¿Cómo has estado? / ¿Cómo ha estado usted?",
      "translations": {
        "en": "How have you been?",
        "fr": "Comment vas-tu ces derniers temps ? / Comment allez-vous ces derniers temps ?",
        "it": "Come stai ultimamente? / Come sta ultimamente?",
        "pt": "Como você tem passado? / Como o senhor tem passado? / Como a senhora tem passado?"
      },
      "image_url": ""
    },
    {
      "id": "sd_018",
      "es": "¿Cómo van las cosas? / ¿Cómo va todo?",
      "translations": {
        "en": "How are things going? / How's everything going?",
        "fr": "Comment vont les choses ? / Comment ça se passe ?",
        "it": "Come vanno le cose? / Come va tutto?",
        "pt": "Como vão as coisas? / Como vai tudo?"
      },
      "image_url": ""
    },
    {
      "id": "sd_020",
      "es": "¿Todo bien?",
      "translations": {
        "en": "All good?",
        "fr": "Tout va bien ?",
        "it": "Tutto bene?",
        "pt": "Tudo bem?"
      },
      "image_url": ""
    },
    {
      "id": "sd_021",
      "es": "¿Qué hay de nuevo?",
      "translations": {
        "en": "What's new?",
        "fr": "Quoi de neuf ?",
        "it": "Che novità?",
        "pt": "O que há de novo?"
      },
      "image_url": ""
    },
    {
      "id": "sd_022",
      "es": "¿Qué onda? / ¿Qué pasa?",
      "translations": {
        "en": "What's up?",
        "fr": "Quoi de neuf ? / Ça roule ?",
        "it": "Che si dice? / Come butta?",
        "pt": "E aí?"
      },
      "image_url": "",
      "notes": {
        "es": "(Coloquial, como saludo)",
        "fr": "(Informal) Quoi de neuf ? también significa «¿Qué hay de nuevo?»; ça roule ? es más coloquial.",
        "it": "(Coloquial) Come butta? es más familiar.",
        "pt": "(Coloquial)"
      }
    },
    {
      "id": "sd_023",
      "es": "¿Qué tal tu día? / ¿Qué tal su día?",
      "translations": {
        "en": "How's your day going?",
        "fr": "Comment se passe ta journée ? / Comment se passe votre journée ?",
        "it": "Come va la tua giornata? / Come va la sua giornata?",
        "pt": "Como está sendo o seu dia?"
      },
      "image_url": ""
    },
    {
      "id": "sd_025",
      "es": "¿En qué andas?",
      "translations": {
        "en": "What are you up to?",
        "fr": "Tu fais quoi en ce moment ?",
        "it": "Che fai di bello? / Che combini?",
        "pt": "O que você anda fazendo?"
      },
      "image_url": "",
      "notes": {
        "es": "(Informal)",
        "it": "Che combini? puede expresar curiosidad o sugerir que alguien está tramando algo."
      }
    },
    {
      "id": "sd_035",
      "es": "Muy bien, gracias",
      "translations": {
        "en": "Very well, thank you / Fine, thank you",
        "fr": "Très bien, merci",
        "it": "Molto bene, grazie",
        "pt": "Muito bem, obrigado / Muito bem, obrigada"
      },
      "image_url": "",
      "notes": {
        "pt": "Obrigado si habla un hombre; obrigada si habla una mujer."
      }
    },
    {
      "id": "sd_036",
      "es": "Todo bien.",
      "translations": {
        "en": "All good.",
        "fr": "Tout va bien.",
        "it": "Tutto bene.",
        "pt": "Tudo bem."
      },
      "image_url": ""
    },
    {
      "id": "sd_037",
      "es": "Más o menos",
      "translations": {
        "en": "So-so",
        "fr": "Comme ci, comme ça",
        "it": "Così così",
        "pt": "Mais ou menos"
      },
      "image_url": ""
    },
    {
      "id": "sd_038",
      "es": "No muy bien",
      "translations": {
        "en": "Not very well",
        "fr": "Pas très bien",
        "it": "Non molto bene",
        "pt": "Não muito bem"
      },
      "image_url": ""
    },
    {
      "id": "sd_107",
      "es": "Nada mal",
      "translations": {
        "en": "Not bad",
        "fr": "Pas mal",
        "it": "Non male",
        "pt": "Nada mal"
      },
      "image_url": ""
    },
    {
      "id": "sd_108",
      "es": "Hasta ahora, todo bien.",
      "translations": {
        "en": "So far, so good.",
        "fr": "Jusqu'ici, tout va bien.",
        "it": "Finora tutto bene.",
        "pt": "Até agora, tudo bem."
      },
      "image_url": ""
    },
    {
      "id": "sd_039",
      "es": "Estoy bien, gracias. ¿Y tú? / Estoy bien, gracias. ¿Y usted?",
      "translations": {
        "en": "I'm fine, thanks. And you?",
        "fr": "Je vais bien, merci. Et toi ? / Je vais bien, merci. Et vous ?",
        "it": "Sto bene, grazie. E tu? / Sto bene, grazie. E lei?",
        "pt": "Estou bem, obrigado. E você? / Estou bem, obrigada. E você? / Estou bem, obrigado. E o senhor? / Estou bem, obrigada. E o senhor? / Estou bem, obrigado. E a senhora? / Estou bem, obrigada. E a senhora?"
      },
      "image_url": "",
      "notes": {
        "pt": "Obrigado / obrigada depende de quien habla; o senhor / a senhora de la persona a quien se dirige."
      }
    },
    {
      "id": "sd_024",
      "es": "¡Cuánto tiempo!",
      "translations": {
        "en": "Long time no see!",
        "fr": "Ça fait longtemps !",
        "it": "Da quanto tempo!",
        "pt": "Quanto tempo!"
      },
      "image_url": "",
      "notes": {
        "es": "(Reencuentro después de mucho tiempo)"
      }
    },
    {
      "id": "sd_026",
      "es": "¡Qué sorpresa!",
      "translations": {
        "en": "What a surprise!",
        "fr": "Quelle surprise !",
        "it": "Che sorpresa!",
        "pt": "Que surpresa!"
      },
      "image_url": ""
    },
    {
      "id": "sd_027",
      "es": "¡Qué gusto verte! / ¡Qué gusto verlo! / ¡Qué gusto verla!",
      "translations": {
        "en": "It's great to see you! / It's a pleasure to see you!",
        "fr": "Ça fait plaisir de te voir ! / Quel plaisir de vous voir !",
        "it": "Che piacere vederti! / Che piacere vederla!",
        "pt": "Que bom ver você! / Que prazer vê-lo! / Que prazer vê-la!"
      },
      "image_url": "",
      "notes": {
        "fr": "Te es informal; vous es formal o plural.",
        "pt": "Ver você es cotidiano; vê-lo y vê-la pueden sonar más formales."
      }
    },
    {
      "id": "sd_029",
      "es": "¡Qué gusto volver a verte! / ¡Qué gusto volver a verlo! / ¡Qué gusto volver a verla!",
      "translations": {
        "en": "It's good to see you again!",
        "fr": "Ça fait plaisir de te revoir ! / Ça fait plaisir de vous revoir !",
        "it": "Che piacere rivederti! / Che piacere rivederla!",
        "pt": "Que bom ver você de novo! / Que prazer revê-lo! / Que prazer revê-la!"
      },
      "image_url": ""
    },
    {
      "id": "sd_030",
      "es": "Mucho gusto / Encantado / Encantada",
      "translations": {
        "en": "Nice to meet you",
        "fr": "Enchanté / Enchantée",
        "it": "Piacere",
        "pt": "Prazer"
      },
      "image_url": "",
      "notes": {
        "fr": "Enchanté si habla un hombre; enchantée si habla una mujer."
      }
    },
    {
      "id": "sd_031",
      "es": "Es un placer conocerte. / Es un placer conocerlo. / Es un placer conocerla.",
      "translations": {
        "en": "It's a pleasure to meet you.",
        "fr": "C'est un plaisir de te rencontrer. / C'est un plaisir de vous rencontrer.",
        "it": "È un piacere conoscerti. / È un piacere conoscerla.",
        "pt": "É um prazer conhecer você. / É um prazer conhecê-lo. / É um prazer conhecê-la."
      },
      "image_url": ""
    },
    {
      "id": "sd_033",
      "es": "El placer es mío.",
      "translations": {
        "en": "The pleasure is mine.",
        "fr": "Tout le plaisir est pour moi.",
        "it": "Il piacere è mio.",
        "pt": "O prazer é meu."
      },
      "image_url": ""
    },
    {
      "id": "sd_034",
      "es": "Igualmente",
      "translations": {
        "en": "Likewise",
        "fr": "De même",
        "it": "Altrettanto",
        "pt": "Igualmente"
      },
      "image_url": ""
    },
    {
      "id": "sd_101",
      "es": "Igualmente, mucho gusto",
      "translations": {
        "en": "Nice to meet you too",
        "fr": "Enchanté également / Enchantée également",
        "it": "Piacere mio",
        "pt": "Prazer em conhecer você também"
      },
      "image_url": "",
      "notes": {
        "es": "(Respuesta al conocer a alguien)"
      }
    },
    {
      "id": "sd_043",
      "es": "Adiós",
      "translations": {
        "en": "Goodbye",
        "fr": "Au revoir",
        "it": "Arrivederci / Arrivederla",
        "pt": "Tchau"
      },
      "image_url": "",
      "notes": {
        "it": "Arrivederla es más formal y se dirige a una sola persona.",
        "pt": "Tchau es la despedida cotidiana; adeus suele sugerir una separación definitiva."
      }
    },
    {
      "id": "sd_044",
      "es": "Chao",
      "translations": {
        "en": "Bye",
        "fr": "Salut",
        "it": "Ciao",
        "pt": "Tchau"
      },
      "image_url": "",
      "notes": {
        "es": "(Informal)",
        "fr": "(Informal) También se usa al llegar.",
        "it": "(Informal) También se usa al llegar."
      }
    },
    {
      "id": "sd_045",
      "es": "Hasta luego / Nos vemos luego",
      "translations": {
        "en": "See you later",
        "fr": "À plus tard / On se voit plus tard.",
        "it": "A dopo / Ci vediamo dopo.",
        "pt": "Até logo / A gente se vê mais tarde."
      },
      "image_url": ""
    },
    {
      "id": "sd_047",
      "es": "Hasta pronto / Nos vemos pronto",
      "translations": {
        "en": "See you soon",
        "fr": "À bientôt / On se voit bientôt.",
        "it": "A presto / Ci vediamo presto.",
        "pt": "Até breve / A gente se vê em breve."
      },
      "image_url": ""
    },
    {
      "id": "sd_048",
      "es": "Adiós para siempre",
      "translations": {
        "en": "Farewell",
        "fr": "Adieu",
        "it": "Addio",
        "pt": "Adeus"
      },
      "image_url": "",
      "notes": {
        "es": "(Despedida definitiva)",
        "en": "Farewell suena solemne o literario en el uso cotidiano.",
        "pt": "Adeus suele implicar una separación prolongada o definitiva en Brasil."
      }
    },
    {
      "id": "sd_049",
      "es": "Hasta mañana / Nos vemos mañana",
      "translations": {
        "en": "See you tomorrow",
        "fr": "À demain / On se voit demain.",
        "it": "A domani / Ci vediamo domani.",
        "pt": "Até amanhã / A gente se vê amanhã."
      },
      "image_url": ""
    },
    {
      "id": "sd_050",
      "es": "Nos vemos en un momento",
      "translations": {
        "en": "See you in a moment",
        "fr": "À tout de suite",
        "it": "A tra poco",
        "pt": "Até já"
      },
      "image_url": ""
    },
    {
      "id": "sd_051",
      "es": "Hasta dentro de un rato",
      "translations": {
        "en": "See you in a bit",
        "fr": "À tout à l'heure",
        "it": "A più tardi",
        "pt": "Até daqui a pouco"
      },
      "image_url": "",
      "notes": {
        "fr": "À tout à l'heure se usa cuando se espera volver a ver a alguien ese mismo día."
      }
    },
    {
      "id": "sd_052",
      "es": "Hasta la próxima",
      "translations": {
        "en": "Until next time",
        "fr": "À la prochaine",
        "it": "Alla prossima",
        "pt": "Até a próxima"
      },
      "image_url": ""
    },
    {
      "id": "sd_053",
      "es": "Nos vemos",
      "translations": {
        "en": "See you",
        "fr": "À plus",
        "it": "Ci vediamo",
        "pt": "Até mais"
      },
      "image_url": "",
      "notes": {
        "fr": "(Informal) À plus es una despedida breve."
      }
    },
    {
      "id": "sd_055",
      "es": "Nos vemos esta tarde.",
      "translations": {
        "en": "See you this afternoon.",
        "fr": "On se voit cet après-midi.",
        "it": "Ci vediamo questo pomeriggio.",
        "pt": "A gente se vê hoje à tarde."
      },
      "image_url": ""
    },
    {
      "id": "sd_056",
      "es": "Nos vemos esta noche.",
      "translations": {
        "en": "See you tonight.",
        "fr": "On se voit ce soir.",
        "it": "Ci vediamo stasera.",
        "pt": "A gente se vê hoje à noite."
      },
      "image_url": ""
    },
    {
      "id": "sd_057",
      "es": "Hasta mañana por la mañana",
      "translations": {
        "en": "See you tomorrow morning",
        "fr": "À demain matin",
        "it": "A domani mattina",
        "pt": "Até amanhã de manhã"
      },
      "image_url": ""
    },
    {
      "id": "sd_058",
      "es": "Hasta el lunes",
      "translations": {
        "en": "See you on Monday",
        "fr": "À lundi",
        "it": "A lunedì",
        "pt": "Até segunda-feira"
      },
      "image_url": ""
    },
    {
      "id": "sd_059",
      "es": "Hasta la semana que viene",
      "translations": {
        "en": "See you next week",
        "fr": "À la semaine prochaine",
        "it": "Ci vediamo la settimana prossima",
        "pt": "Até a semana que vem"
      },
      "image_url": ""
    },
    {
      "id": "sd_060",
      "es": "Hasta el mes que viene",
      "translations": {
        "en": "See you next month",
        "fr": "Au mois prochain",
        "it": "Al mese prossimo",
        "pt": "Até o mês que vem"
      },
      "image_url": ""
    },
    {
      "id": "sd_061",
      "es": "Hasta el año que viene",
