    {
      "id": "pa229",
      "es": "¿Me enseñas a jugar? / ¿Me enseña a jugar?",
      "translations": {
        "en": "Can you teach me how to play?",
        "pt": "Você pode me ensinar a jogar? / O senhor pode me ensinar a jogar? / A senhora pode me ensinar a jogar?",
        "fr": "Tu peux m'apprendre à jouer ? / Pouvez-vous m'apprendre à jouer ?",
        "it": "Mi insegni a giocare? / Mi insegna a giocare?",
        "de": "Kannst du mir zeigen, wie man spielt? / Können Sie mir zeigen, wie man spielt?"
      },
      "image_url": "",
      "notes": {
        "pt": "«Você» es de uso cotidiano. «O senhor» y «a senhora» expresan un trato más formal.",
        "de": "Primero va el trato informal con «du» y después el formal con «Sie»."
      }
    },
    {
      "id": "pa230",
      "es": "¿A quién le toca?",
      "translations": {
        "en": "Whose turn is it?",
        "pt": "De quem é a vez?",
        "fr": "C'est à qui de jouer ?",
        "it": "A chi tocca?",
        "de": "Wer ist an der Reihe?"
      },
      "image_url": "",
      "notes": {
        "es": "(Turno en un juego)",
        "de": "Coloquial: Wer ist dran?"
      }
    },
    {
      "id": "pa231",
      "es": "Me toca a mí.",
      "translations": {
        "en": "It's my turn.",
        "pt": "É a minha vez.",
        "fr": "C'est à moi de jouer.",
        "it": "Tocca a me.",
        "de": "Ich bin an der Reihe."
      },
      "image_url": "",
      "notes": {
        "es": "(Turno en un juego)",
        "de": "Coloquial: Ich bin dran."
      }
    },
    {
      "id": "pa232",
      "es": "¿Quién ganó?",
      "translations": {
        "en": "Who won?",
        "pt": "Quem ganhou?",
        "fr": "Qui a gagné ?",
        "it": "Chi ha vinto?",
        "de": "Wer hat gewonnen?"
      },
      "image_url": ""
    },
    {
      "id": "pa239",
      "es": "¿Qué tal si jugamos a las cartas?",
      "translations": {
        "en": "How about we play cards?",
        "pt": "Que tal jogarmos cartas?",
        "fr": "Et si on jouait aux cartes ?",
        "it": "Che ne dici di giocare a carte?",
        "de": "Wie wäre es, wenn wir Karten spielen?"
      },
      "image_url": ""
    },
    {
      "id": "pa240",
      "es": "¿Puedo jugar con ustedes?",
      "translations": {
        "en": "Can I play with you?",
        "pt": "Posso jogar com vocês?",
        "fr": "Je peux jouer avec vous ?",
        "it": "Posso giocare con voi?",
        "de": "Darf ich bei euch mitspielen? / Darf ich bei Ihnen mitspielen?"
      },
      "image_url": "",
      "notes": {
        "de": "«Euch» se dirige a un grupo de manera informal. «Ihnen» es la forma de trato formal; aquí se dirige al grupo."
      }
    }
  ]
