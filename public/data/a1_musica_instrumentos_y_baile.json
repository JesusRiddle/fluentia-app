    {
      "id": "pa131",
      "es": "La canción",
      "translations": {
        "en": "The song",
        "pt": "A canção",
        "fr": "La chanson",
        "it": "La canzone",
        "de": "Das Lied"
      },
      "image_url": "",
      "notes": {
        "pt": "En el habla cotidiana de Brasil también se dice «uma música» para una canción; como término general, «a música» es la música. (Plural: As canções)",
        "en": "(Plural: The songs)",
        "fr": "(Plural: Les chansons)",
        "it": "(Plural: Le canzoni)",
        "de": "En música popular también se usa «der Song». (Plural: Die Lieder)"
      }
    },
